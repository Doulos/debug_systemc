#!/usr/bin/env bash
#

export VERBOSITY
VERSION=1.3
while [[ "$1" =~ ^- ]]; do
  case "$1" in
    -h|-help|--help)
      cat <<'HELPTEXT'
Name
----
build-expected - Install Tartan Llama's implementation of std::expected under current project.

Synopsis
--------
build-expected --help|-h # produces this text
build-expected [-v|-q]

Description
-----------
Installs the header-only expected code under the directory `extern/include`, which is located based on the top-level git repository's location.

IMPORTANT
---------
Must be run inside project git repository.

HELPTEXT
      exit 0;
      ;;
    -q|--quiet)
      VERBOSITY=0
      ;;
    -v|--verbose)
      VERBOSITY=1
      ;;
    --version|-version)
      echo "build-expected version ${VERSION}"
      exit 0
      ;;
    *)
      ;;
  esac
  shift
done

LIBNAME="Tartan Llama's implementation of std::expected"
GIT_URL="https://github.com/TartanLlama/expected.git"
HEADERS=( "include/" )

function Realpath() {
  if [[ $# == 0 ]]; then set - .; fi
  /usr/bin/perl '-MCwd(abs_path)' -le '$p=abs_path(join(q( ),@ARGV));print $p if -e $p' "$*"
}

# Using Essential-IO
SCRIPTDIR="$(Realpath "$(dirname "$0")"/../scripts)"
if [[ ! -r "${SCRIPTDIR}/Essential-IO" ]]; then
  SCRIPTDIR="$(Realpath ~/.portable-scripts/scripts)"
fi
if [[ ! -r "${SCRIPTDIR}/Essential-IO" ]]; then
  SCRIPTDIR="$(Realpath "$(dirname "$0")")"
fi
if [[ ! -r "${SCRIPTDIR}/Essential-IO" ]]; then
  printf "FATAL: Missing required source file '%s'\n" "${SCRIPTDIR}/Essential-IO"
  crash
fi
# shellcheck disable=SC2250,SC1091
source "$SCRIPTDIR/Essential-IO"

# TOOL_PATH REPO_DIR INSTALL_DIR
#
TOOL_PATH="$(Realpath "$0")"
Report_info "Attempting to build ${LIBNAME} using ${TOOL_PATH}"
INSTALL_DIR="$(find_extern -s)"
if [[ -z "${INSTALL_DIR}" ]]; then
  Report_fatal "Unable to locate required extern/include directory" ;
  return 1
fi
REPO_DIR="$(basename "${GIT_URL}" .git)"
_do mkdir -p "${INSTALL_DIR}"
_do cd "${INSTALL_DIR}" || Report_fatal "Unable to enter ${INSTALL_DIR}"
Report_info "Building under ${INSTALL_DIR}"
if [[ -d "${REPO_DIR}/.git" ]]; then
  _do git -C "${REPO_DIR}" pull
  Report_info "Successfully updated ${LIBNAME}"
else
  _do rm -fr "${REPO_DIR}"
  _do git clone "${GIT_URL}" || Report_fatal "Unable to clone"
  Report_info "Successfully installed ${LIBNAME}"
fi
declare -a FILES
FILES=()
for HEADER in "${HEADERS[@]}"; do
  FILES+=( "${REPO_DIR}/${HEADER}" )
done
_do rsync -av "${FILES[@]}" "${INSTALL_DIR}/include/" || Report_fatal "Unable to install"
Report_info "Successfully built ${LIBNAME}"

# vim:nospell
